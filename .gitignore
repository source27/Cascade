# Cascade monorepo (package + docs + CI). Nested Unity example:
#   Examples/CascadeExample/.gitignore

# --- OS / editors ---
.DS_Store
Thumbs.db
.utmp/
.vs/
.idea/
*.DotSettings.user
*.user
*.userprefs

# --- logs ---
*.log

# --- Cascade Roslyn generator (Tools~ is not imported by Unity) ---
Cascade/Tools~/**/bin/
Cascade/Tools~/**/obj/
!Cascade/Tools~/**/*.csproj
!Cascade/Tools~/**/*.sln
