# Cascade monorepo (package + docs + CI). Nested Unity example:
#   Examples/CascadeExample/.gitignore

# --- OS / editors ---
.DS_Store
Thumbs.db
.utmp/
.vs/
.idea/
*.DotSettings.user
*.user
*.userprefs

# --- logs ---
*.log

# --- Roslyn generators shipped in Modules (Tools~ is not imported by Unity) ---
Modules/*/Tools~/**/bin/
Modules/*/Tools~/**/obj/
!Modules/*/Tools~/**/*.csproj
!Modules/*/Tools~/**/*.sln
